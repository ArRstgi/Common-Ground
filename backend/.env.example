# Copy this file to .env and fill in your Supabase project values.
# Find these in your Supabase project under: Settings → API

# Your project URL (e.g. https://xyzxyzxyz.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (replaces the old "anon" key) — safe to expose in clients
# Format: sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Secret key (replaces the old "service_role" key) — backend only, never expose
# Format: sb_secret_...
SUPABASE_SECRET_KEY=sb_secret_your-key-here